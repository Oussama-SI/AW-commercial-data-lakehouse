{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-adventWork"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureSqlDatabasemaster_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabasemaster'"
		},
		"commercial_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'commercial_db'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sadbxoussama.dfs.core.windows.net/"
		},
		"AzureSqlDatabasemaster_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "db-server-webelian-training.database.windows.net"
		},
		"AzureSqlDatabasemaster_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "master"
		},
		"AzureSqlDatabasemaster_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "bourrous"
		},
		"commercial_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "db-server-webelian-training.database.windows.net"
		},
		"commercial_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "commercial-db"
		},
		"commercial_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "bourrous"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-adventWork_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureSqlDatabasemaster_password": {
						"value": "[parameters('AzureSqlDatabasemaster_password')]"
					},
					"commercial_db_password": {
						"value": "[parameters('commercial_db_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"AzureSqlDatabasemaster_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabasemaster_properties_typeProperties_server')]"
					},
					"AzureSqlDatabasemaster_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabasemaster_properties_typeProperties_database')]"
					},
					"AzureSqlDatabasemaster_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabasemaster_properties_typeProperties_userName')]"
					},
					"commercial_db_properties_typeProperties_server": {
						"value": "[parameters('commercial_db_properties_typeProperties_server')]"
					},
					"commercial_db_properties_typeProperties_database": {
						"value": "[parameters('commercial_db_properties_typeProperties_database')]"
					},
					"commercial_db_properties_typeProperties_userName": {
						"value": "[parameters('commercial_db_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}